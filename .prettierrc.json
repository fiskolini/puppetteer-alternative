{
  "printWidth": 120,
  "tabWidth": 4,
  "trailingComma": "es5",
  "singleQuote": true,
  "semi": true,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.yaml", "*.yml"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
